# Win key. Use Mod1 for Alt.
set $mod Mod4

# Vim keys
set $left h
set $down j
set $up k
set $right l

# Colors (misty forest, matches trees.webp and waybar/style.css)
set $bg     1c2225
set $fg     d3dad5
set $accent 93a99c
set $dim    2e383c
set $muted  7f8b85

# Default Terminal
set $term kitty
# Default Application Launcher (apps with icons; colors in ~/.config/fuzzel/fuzzel.ini)
set $menu fuzzel
# Fallback: plain command launcher
# set $menu wmenu-run -N $bg -n $fg -S $accent -s $bg

# Monitor brightness/contrast via DDC/CI (absolute path: ~/.local/bin may not be in sway's PATH)
set $monictrl ~/.local/bin/monictrl

# Starts Notification Daemon
exec mako

# to use GUI applications with sudo privileges
exec lxpolkit

# Regenerates the sage GTK theme (Adwaita-sage) only after a GTK update
exec ~/.local/bin/gtk-sage-theme --if-changed

# Disables borders
default_border pixel 2
# class                 border   background text    indicator child_border
client.focused          #$accent #$accent   #$bg    #$fg      #$accent
client.focused_inactive #$dim    #$dim      #$fg    #$dim     #$dim
client.unfocused        #$dim    #$bg       #$muted #$dim     #$dim
gaps inner 10
gaps outer 10


# Wallpaper
output * bg /home/alex/.config/sway/trees.webp fill

output HDMI-A-1 mode 1920x1080@120Hz

bindsym $mod+Control+m output "HDMI-A-1" power toggle
bindsym $mod+Shift+p exec "systemctl suspend"

# Layout tastiera
input type:keyboard {
    xkb_layout "it(us)"
    # Additional Control key instead of CapsLock
    # xkb_options ctrl:nocaps
}

bindsym $mod+Return exec $term
bindsym $mod+Shift+b exec firefox
bindsym $mod+Shift+q kill
bindsym $mod+d exec $menu

# $mod + left mouse to move
# $mod + right mouse to resize
floating_modifier $mod normal

# Reload the configuration file
bindsym $mod+Shift+c reload

# Logout
bindsym $mod+Shift+e exec swaynag -t warning -m 'Do you want to Logout?' -B 'Logout' 'swaymsg exit'

# Change focus with vim keys
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
# Same, but with arrows
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move the focused window with the same, but add Shift
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# Workspaces:
# Switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Layout stuff:
bindsym $mod+b splith
bindsym $mod+v splitv

# Switch the current container between different layout styles
# bindsym $mod+s layout stacking
# bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Make the current focus fullscreen
bindsym $mod+f fullscreen

# Toggle the current focus between tiling and floating mode
bindsym $mod+Shift+space floating toggle

# Swap focus between the tiling area and the floating area
bindsym $mod+space focus mode_toggle

# Move focus to the parent container
bindsym $mod+a focus parent

# Resizing
mode "resize" {
    # Fast Shrink, using vim keys
    bindsym $left resize shrink width 30px
    bindsym $down resize grow height 30px
    bindsym $up resize shrink height 30px
    bindsym $right resize grow width 30px

    # Precision Shrink, using arrows
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Small panels (opened from waybar) float centered instead of tiling
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable, resize set 800 500, move position center
for_window [app_id="blueman-manager"] floating enable, resize set 700 450, move position center
for_window [app_id="nmtui"] floating enable, resize set 800 550, move position center


# Sets Wob (brightness and volume indicator)
set $WOBSOCK $XDG_RUNTIME_DIR/wob.sock
# wob reads the FIFO directly (opened read-write, so it never hits EOF):
# "tail -f" on a FIFO only polls once per second, which made wob lag behind
exec rm -f $WOBSOCK && mkfifo $WOBSOCK && wob <> $WOBSOCK

# Pipewire Volume Control
# using laptop dedicated keys
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && wpctl get-volume @DEFAULT_AUDIO_SINK@ | sed 's/[^0-9]//g' > $WOBSOCK
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && wpctl get-volume @DEFAULT_AUDIO_SINK@ | sed 's/[^0-9]//g' > $WOBSOCK
# using arrow keys
bindsym --locked $mod+Shift+Right exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && wpctl get-volume @DEFAULT_AUDIO_SINK@ | sed 's/[^0-9]//g' > $WOBSOCK
bindsym --locked $mod+Shift+Left exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && wpctl get-volume @DEFAULT_AUDIO_SINK@ | sed 's/[^0-9]//g' > $WOBSOCK
# mute
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && (wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo 0 > $WOBSOCK) || wpctl get-volume @DEFAULT_AUDIO_SINK@ | sed 's/[^0-9]//g' > $WOBSOCK

# Media player control (any MPRIS player: Firefox, Spotify, mpv...)
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioStop exec playerctl stop

# Brightness Control (external monitor via DDC/CI, no backlight device on this PC)
# using keyboard dedicated keys, if present
bindsym --locked XF86MonBrightnessUp exec $monictrl 10 +5 > $WOBSOCK
bindsym --locked XF86MonBrightnessDown exec $monictrl 10 -5 > $WOBSOCK

# using Ctrl + keyboard volume knob
bindsym --locked Control+XF86AudioRaiseVolume exec $monictrl 10 +5 > $WOBSOCK
bindsym --locked Control+XF86AudioLowerVolume exec $monictrl 10 -5 > $WOBSOCK

# change contrast external monitor
bindsym --locked $mod+Control+u exec $monictrl 12 +10 > $WOBSOCK
bindsym --locked $mod+Control+d exec $monictrl 12 -10 > $WOBSOCK

# change brightness external monitor
bindsym --locked $mod+Shift+u exec $monictrl 10 +10 > $WOBSOCK
bindsym --locked $mod+Shift+d exec $monictrl 10 -10 > $WOBSOCK

# Take Screenshots, goes directly into Images folder
bindsym Print exec grim
# Screenshot of a selected area, copied to clipboard
bindsym Shift+Print exec grim -g "$(slurp)" - | wl-copy

bar {
    swaybar_command waybar
}

